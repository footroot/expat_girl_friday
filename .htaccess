# ==============================================================================
# XAMPP LOCALHOST .HTACCESS CONFIGURATION WITH CLEAN URLS & CUSTOM 404
# ==============================================================================

# 1. PREVENT DIRECTORY BROWSING
Options -Indexes

# 2. DEFAULT DOCUMENT SETTING
DirectoryIndex index.php

# 3. CUSTOM ERROR PAGES
# Route missing files/routes through 404.php (or /404 using clean URLs)
ErrorDocument 404 /courses/expat_girl_friday/404

# 4. SECURITY: BLOCK ACCESS TO SENSITIVE FILES
<FilesMatch "^\.|\.(env|sql|log|md|json|sh|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. REWRITE ENGINE & CLEAN PHP URLS
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent internal rewrites from looping continuously
    RewriteCond %{ENV:REDIRECT_STATUS} 200
    RewriteRule ^ - [L]

    # Rule A: Redirect explicit request for page.php to clean /page (Browser URL cleanup)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Rule B: Map /page to page.php internally if page.php exists as a file
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
</IfModule>

# 6. PHP & ENVIRONMENT HARDENING
<IfModule mod_php7.c>
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
    php_value display_errors On
</IfModule>
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.use_strict_mode 1
    php_value display_errors On
</IfModule>